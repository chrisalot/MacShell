<Application
    x:Class="MacShell.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 Resources -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- MacShell Themes -->
                <ResourceDictionary Source="ms-appx:///MacShell.UI/Resources/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="ms-appx:///MacShell.UI/Resources/Themes/LightTheme.xaml" />

                <!-- MacShell Styles -->
                <ResourceDictionary Source="ms-appx:///MacShell.UI/Resources/Styles/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>