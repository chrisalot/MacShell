<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MacShell.App</RootNamespace>
    <AssemblyName>MacShell</AssemblyName>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Disable XAML compiler to avoid WMC9999 error - App has no XAML files but references UI project -->
    <WindowsAppSDKPackage>false</WindowsAppSDKPackage>
    <UseWinUI>false</UseWinUI>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <XamlCompilerUseNetCore>false</XamlCompilerUseNetCore>
    <UseNetCoreXamlCompiler>false</UseNetCoreXamlCompiler>
    <DisableXbfCompiler>true</DisableXbfCompiler>
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <EnableXamlCompilation>false</EnableXamlCompilation>
    <XamlDebuggingInformation>false</XamlDebuggingInformation>
    <DisableMsix>true</DisableMsix>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateMsixMetadata>false</GenerateMsixMetadata>
    <!-- Prevent default XAML item detection since App has no XAML files -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacShell.Core\MacShell.Core.csproj" />
    <ProjectReference Include="..\MacShell.UI\MacShell.UI.csproj" />
    <ProjectReference Include="..\MacShell.Widgets\ClockWidget\ClockWidget.csproj" />
    <ProjectReference Include="..\MacShell.Widgets\SystemMonitorWidget\SystemMonitorWidget.csproj" />
    <ProjectReference Include="..\MacShell.Widgets\WeatherWidget\WeatherWidget.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MicrosoftWindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsLoggingVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>