<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MacShell.UI</RootNamespace>
    <AssemblyName>MacShell.UI</AssemblyName>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DisableMsix>true</DisableMsix>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateMsixMetadata>false</GenerateMsixMetadata>
    <WindowsAppSDKPackage>false</WindowsAppSDKPackage>
    <UseWinUI>true</UseWinUI>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetPlatformIdentifier>windows</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- Disable XAML compiler to avoid WMC9999 error - we use runtime XAML loading via XamlReader.Load() -->
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <XamlCompilerUseNetCore>false</XamlCompilerUseNetCore>
    <UseNetCoreXamlCompiler>false</UseNetCoreXamlCompiler>
    <DisableXbfCompiler>true</DisableXbfCompiler>
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <EnableXamlCompilation>false</EnableXamlCompilation>
    <XamlDebuggingInformation>false</XamlDebuggingInformation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacShell.Core\MacShell.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(MicrosoftWindowsAppSDKVersion)" />
    <PackageReference Include="CommunityToolkit.WinUI" Version="$(CommunityToolkitWinUIVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Windows.Markup.XmlnsDefinition">
      <_Parameter1>using:MacShell.UI.Controls</_Parameter1>
      <_Parameter2>MacShell.UI.Controls</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Windows.Markup.XmlnsDefinition">
      <_Parameter1>using:MacShell.UI.Converters</_Parameter1>
      <_Parameter2>MacShell.UI.Converters</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Windows.Markup.XmlnsPrefix">
      <_Parameter1>using:MacShell.UI.Controls</_Parameter1>
      <_Parameter2>controls</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Windows.Markup.XmlnsPrefix">
      <_Parameter1>using:MacShell.UI.Converters</_Parameter1>
      <_Parameter2>converters</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Only include XAML files from source directories, not from output directories -->
    <Content Include="Resources\**\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Override XAML compiler settings after targets import to disable XAML compilation -->
  <PropertyGroup>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <EnableXamlCompilation>false</EnableXamlCompilation>
  </PropertyGroup>
</Project>