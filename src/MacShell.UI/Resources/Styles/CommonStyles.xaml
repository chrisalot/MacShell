<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacShell.UI.Controls"
    xmlns:converters="using:MacShell.UI.Converters">

    <!-- ============================================================
         COMMON STYLES FOR MAC SHELL
         ============================================================ -->

    <!-- Rounded Panel Base Style -->
    <Style x:Key="MacShellRoundedPanelStyle" TargetType="controls:RoundedPanel">
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusLarge}" />
        <Setter Property="Background" Value="{StaticResource MacShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Shadow" Value="{StaticResource MacShellShadowMedium}" />
    </Style>

    <!-- Dock Panel Style -->
    <Style x:Key="MacShellDockPanelStyle" TargetType="controls:DockPanel">
        <Setter Property="Background" Value="{StaticResource MacShellDockAcrylicBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusXLarge}" />
        <Setter Property="Padding" Value="{StaticResource MacShellSpacingM}" />
        <Setter Property="ItemSpacing" Value="{StaticResource MacShellSpacingS}" />
        <Setter Property="MagnificationFactor" Value="1.4" />
        <Setter Property="MagnificationRadius" Value="80" />
        <Setter Property="Shadow" Value="{StaticResource MacShellShadowLarge}" />
    </Style>

    <!-- Dock Item Style -->
    <Style x:Key="MacShellDockItemStyle" TargetType="controls:DockItemControl">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="IconSize" Value="28" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RunningIndicatorSize" Value="8" />
        <Setter Property="ToolTipTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Style="{StaticResource MacShellTextStyleCaption}"
                               Text="{Binding Name}"
                               Padding="{StaticResource MacShellSpacingS}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top Bar Style -->
    <Style x:Key="MacShellTopBarStyle" TargetType="controls:TopBar">
        <Setter Property="Background" Value="{StaticResource MacShellTopBarAcrylicBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellTopBarSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- System Tray Item Style -->
    <Style x:Key="MacShellSystemTrayItemStyle" TargetType="controls:SystemTrayItem">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeS}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
    </Style>

    <!-- Launcher Window Style -->
    <Style x:Key="MacShellLauncherWindowStyle" TargetType="controls:LauncherWindow">
        <Setter Property="OverlayBrush" Value="{StaticResource MacShellLauncherOverlayBrush}" />
        <Setter Property="PanelBackground" Value="{StaticResource MacShellLauncherAcrylicBrush}" />
        <Setter Property="PanelCornerRadius" Value="{StaticResource MacShellCornerRadiusXLarge}" />
        <Setter Property="PanelWidth" Value="640" />
        <Setter Property="PanelMaxHeight" Value="480" />
        <Setter Property="Shadow" Value="{StaticResource MacShellShadowLarge}" />
    </Style>

    <!-- Search Box Style -->
    <Style x:Key="MacShellSearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeXL}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightLight}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource MacShellLauncherInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusRound}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="PlaceholderText" Value="Search..." />
        <Setter Property="TextBoxStyle">
            <Setter.Value>
                <Style TargetType="TextBox">
                    <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
                    <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeXL}" />
                    <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightLight}" />
                    <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CaretBrush" Value="{StaticResource MacShellAccentBrush}" />
                    <Setter Property="SelectionHighlightColor" Value="{StaticResource MacShellAccentColor}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search Result Item Style -->
    <Style x:Key="MacShellSearchResultItemStyle" TargetType="controls:SearchResultItem">
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="IconSize" Value="24" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HoverBackground" Value="{StaticResource MacShellLauncherResultHoverBrush}" />
        <Setter Property="SelectedBackground" Value="{StaticResource MacShellLauncherResultSelectedBrush}" />
    </Style>

    <!-- Settings Window Style -->
    <Style x:Key="MacShellSettingsWindowStyle" TargetType="Window">
        <Setter Property="Width" Value="640" />
        <Setter Property="Height" Value="520" />
        <Setter Property="MinWidth" Value="560" />
        <Setter Property="MinHeight" Value="480" />
        <Setter Property="Background" Value="{StaticResource MacShellBackgroundBrush}" />
    </Style>

    <!-- Settings NavigationView Style -->
    <Style x:Key="MacShellSettingsNavViewStyle" TargetType="NavigationView">
        <Setter Property="PaneDisplayMode" Value="Left" />
        <Setter Property="IsSettingsVisible" Value="False" />
        <Setter Property="Background" Value="{StaticResource MacShellBackgroundBrush}" />
        <Setter Property="PaneBackground" Value="{StaticResource MacShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="CompactPaneLength" Value="48" />
        <Setter Property="ExpandedPaneWidth" Value="220" />
    </Style>

    <!-- Button Styles -->
    <Style x:Key="MacShellButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeS}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightMedium}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource MacShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellDockItemHoverBrush}" />
                                        <Setter Target="RootBorder.BorderBrush" Value="{StaticResource MacShellBorderLightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellDockItemActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Opacity" Value="0.4" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource MacShellTextDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacShellAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource MacShellButtonStyle}">
        <Setter Property="Background" Value="{StaticResource MacShellAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextOnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellAccentLightBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellAccentDarkBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacShellIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusRound}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellDockItemHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellDockItemActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleSwitch Style -->
    <Style x:Key="MacShellToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- Slider Style -->
    <Style x:Key="MacShellSliderStyle" TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellAccentBrush}" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- ComboBox Style -->
    <Style x:Key="MacShellComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeS}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource MacShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Height" Value="36" />
    </Style>

    <!-- TextBox Style -->
    <Style x:Key="MacShellTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeS}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource MacShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CaretBrush" Value="{StaticResource MacShellAccentBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource MacShellAccentColor}" />
    </Style>

    <!-- Separator Style -->
    <Style x:Key="MacShellSeparatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- Card Style -->
    <Style x:Key="MacShellCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MacShellSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource MacShellSpacingL}" />
        <Setter Property="Shadow" Value="{StaticResource MacShellShadowSmall}" />
    </Style>

    <!-- Flyout Style -->
    <Style x:Key="MacShellFlyoutStyle" TargetType="Flyout">
        <Setter Property="FlyoutPresenterStyle">
            <Setter.Value>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="Background" Value="{StaticResource MacShellElevatedSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="Shadow" Value="{StaticResource MacShellShadowMedium}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuFlyout Style -->
    <Style x:Key="MacShellMenuFlyoutStyle" TargetType="MenuFlyout">
        <Setter Property="MenuFlyoutPresenterStyle">
            <Setter.Value>
                <Style TargetType="MenuFlyoutPresenter">
                    <Setter Property="Background" Value="{StaticResource MacShellElevatedSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacShellBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource MacShellCornerRadiusMedium}" />
                    <Setter Property="Padding" Value="4" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuFlyoutItem Style -->
    <Style x:Key="MacShellMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeS}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutItem">
                    <Border x:Name="RootBorder"
                            Background="Transparent"
                            CornerRadius="{StaticResource MacShellCornerRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ContentPresenter x:Name="IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                            <ContentPresenter x:Name="TextPresenter"
                                              Content="{TemplateBinding Text}"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{TemplateBinding FontSize}"
                                              Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter x:Name="ShortcutPresenter"
                                              Content="{TemplateBinding KeyboardAcceleratorText}"
                                              Grid.Column="2"
                                              VerticalAlignment="Center"
                                              FontFamily="{TemplateBinding FontFamily}"
                                              FontSize="{StaticResource MacShellFontSizeXS}"
                                              Foreground="{StaticResource MacShellTextTertiaryBrush}"
                                              Margin="12,0,0,0" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellDockItemHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{StaticResource MacShellDockItemActiveBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="TextPresenter.Foreground" Value="{StaticResource MacShellTextDisabledBrush}" />
                                        <Setter Target="ShortcutPresenter.Foreground" Value="{StaticResource MacShellTextDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>