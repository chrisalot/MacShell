<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MacShell.UI">

    <!-- ============================================================
         MAC SHELL LIGHT THEME
         Base colors inspired by macOS Light Mode
         ============================================================ -->

    <!-- Primary Background Colors -->
    <Color x:Key="MacShellBackgroundColor">#FFF5F5F7</Color>
    <Color x:Key="MacShellSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="MacShellElevatedSurfaceColor">#FFF5F5F7</Color>
    <Color x:Key="MacShellOverlayColor">#CCFFFFFF</Color>

    <!-- Dock Colors -->
    <Color x:Key="MacShellDockBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="MacShellDockAcrylicTintColor">#FFFFFFFF</Color>
    <Color x:Key="MacShellDockSeparatorColor">#FFE5E5EA</Color>
    <Color x:Key="MacShellDockItemHoverColor">#FFE5E5EA</Color>
    <Color x:Key="MacShellDockItemActiveColor">#FFD1D1D6</Color>
    <Color x:Key="MacShellDockRunningIndicatorColor">#FF34C759</Color>
    <Color x:Key="MacShellDockMagnificationColor">#FFF0F0F0</Color>

    <!-- Top Bar Colors -->
    <Color x:Key="MacShellTopBarBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="MacShellTopBarAcrylicTintColor">#FFFFFFFF</Color>
    <Color x:Key="MacShellTopBarSeparatorColor">#FFE5E5EA</Color>

    <!-- Launcher Colors -->
    <Color x:Key="MacShellLauncherOverlayColor">#CCFFFFFF</Color>
    <Color x:Key="MacShellLauncherPanelBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="MacShellLauncherInputBackgroundColor">#FFF5F5F7</Color>
    <Color x:Key="MacShellLauncherResultHoverColor">#FFE5E5EA</Color>
    <Color x:Key="MacShellLauncherResultSelectedColor">#FF007AFF33</Color>

    <!-- Text Colors -->
    <Color x:Key="MacShellTextPrimaryColor">#FF1D1D1F</Color>
    <Color x:Key="MacShellTextSecondaryColor">#FF86868B</Color>
    <Color x:Key="MacShellTextTertiaryColor">#FFAEAEB2</Color>
    <Color x:Key="MacShellTextDisabledColor">#FFD1D1D6</Color>
    <Color x:Key="MacShellTextOnAccentColor">#FFFFFFFF</Color>

    <!-- Accent Colors (macOS Blue) -->
    <Color x:Key="MacShellAccentColor">#FF007AFF</Color>
    <Color x:Key="MacShellAccentLightColor">#FF007AFF</Color>
    <Color x:Key="MacShellAccentDarkColor">#FF0056CC</Color>
    <Color x:Key="MacShellAccentSecondaryColor">#FF5E5CE6</Color>

    <!-- System Colors -->
    <Color x:Key="MacShellSuccessColor">#FF34C759</Color>
    <Color x:Key="MacShellWarningColor">#FFFF9F0A</Color>
    <Color x:Key="MacShellErrorColor">#FFFF3B30</Color>
    <Color x:Key="MacShellInfoColor">#FF007AFF</Color>

    <!-- Border/Stroke Colors -->
    <Color x:Key="MacShellBorderColor">#FFE5E5EA</Color>
    <Color x:Key="MacShellBorderLightColor">#FFD1D1D6</Color>
    <Color x:Key="MacShellFocusBorderColor">#FF007AFF</Color>

    <!-- Shadow Colors -->
    <Color x:Key="MacShellShadowColor">#FF000000</Color>
    <Color x:Key="MacShellShadowStrongColor">#FF000000</Color>

    <!-- ============================================================
         BRUSHES
         ============================================================ -->

    <SolidColorBrush x:Key="MacShellBackgroundBrush" Color="{StaticResource MacShellBackgroundColor}" />
    <SolidColorBrush x:Key="MacShellSurfaceBrush" Color="{StaticResource MacShellSurfaceColor}" />
    <SolidColorBrush x:Key="MacShellElevatedSurfaceBrush" Color="{StaticResource MacShellElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="MacShellOverlayBrush" Color="{StaticResource MacShellOverlayColor}" />

    <SolidColorBrush x:Key="MacShellDockBackgroundBrush" Color="{StaticResource MacShellDockBackgroundColor}" />
    <SolidColorBrush x:Key="MacShellDockSeparatorBrush" Color="{StaticResource MacShellDockSeparatorColor}" />
    <SolidColorBrush x:Key="MacShellDockItemHoverBrush" Color="{StaticResource MacShellDockItemHoverColor}" />
    <SolidColorBrush x:Key="MacShellDockItemActiveBrush" Color="{StaticResource MacShellDockItemActiveColor}" />
    <SolidColorBrush x:Key="MacShellDockRunningIndicatorBrush" Color="{StaticResource MacShellDockRunningIndicatorColor}" />
    <SolidColorBrush x:Key="MacShellDockMagnificationBrush" Color="{StaticResource MacShellDockMagnificationColor}" />

    <SolidColorBrush x:Key="MacShellTopBarBackgroundBrush" Color="{StaticResource MacShellTopBarBackgroundColor}" />
    <SolidColorBrush x:Key="MacShellTopBarSeparatorBrush" Color="{StaticResource MacShellTopBarSeparatorColor}" />

    <SolidColorBrush x:Key="MacShellLauncherOverlayBrush" Color="{StaticResource MacShellLauncherOverlayColor}" />
    <SolidColorBrush x:Key="MacShellLauncherPanelBackgroundBrush" Color="{StaticResource MacShellLauncherPanelBackgroundColor}" />
    <SolidColorBrush x:Key="MacShellLauncherInputBackgroundBrush" Color="{StaticResource MacShellLauncherInputBackgroundColor}" />
    <SolidColorBrush x:Key="MacShellLauncherResultHoverBrush" Color="{StaticResource MacShellLauncherResultHoverColor}" />
    <SolidColorBrush x:Key="MacShellLauncherResultSelectedBrush" Color="{StaticResource MacShellLauncherResultSelectedColor}" />

    <SolidColorBrush x:Key="MacShellTextPrimaryBrush" Color="{StaticResource MacShellTextPrimaryColor}" />
    <SolidColorBrush x:Key="MacShellTextSecondaryBrush" Color="{StaticResource MacShellTextSecondaryColor}" />
    <SolidColorBrush x:Key="MacShellTextTertiaryBrush" Color="{StaticResource MacShellTextTertiaryColor}" />
    <SolidColorBrush x:Key="MacShellTextDisabledBrush" Color="{StaticResource MacShellTextDisabledColor}" />
    <SolidColorBrush x:Key="MacShellTextOnAccentBrush" Color="{StaticResource MacShellTextOnAccentColor}" />

    <SolidColorBrush x:Key="MacShellAccentBrush" Color="{StaticResource MacShellAccentColor}" />
    <SolidColorBrush x:Key="MacShellAccentLightBrush" Color="{StaticResource MacShellAccentLightColor}" />
    <SolidColorBrush x:Key="MacShellAccentDarkBrush" Color="{StaticResource MacShellAccentDarkColor}" />
    <SolidColorBrush x:Key="MacShellAccentSecondaryBrush" Color="{StaticResource MacShellAccentSecondaryColor}" />

    <SolidColorBrush x:Key="MacShellSuccessBrush" Color="{StaticResource MacShellSuccessColor}" />
    <SolidColorBrush x:Key="MacShellWarningBrush" Color="{StaticResource MacShellWarningColor}" />
    <SolidColorBrush x:Key="MacShellErrorBrush" Color="{StaticResource MacShellErrorColor}" />
    <SolidColorBrush x:Key="MacShellInfoBrush" Color="{StaticResource MacShellInfoColor}" />

    <SolidColorBrush x:Key="MacShellBorderBrush" Color="{StaticResource MacShellBorderColor}" />
    <SolidColorBrush x:Key="MacShellBorderLightBrush" Color="{StaticResource MacShellBorderLightColor}" />
    <SolidColorBrush x:Key="MacShellFocusBorderBrush" Color="{StaticResource MacShellFocusBorderColor}" />

    <!-- Acrylic Brushes -->
    <AcrylicBrush x:Key="MacShellDockAcrylicBrush"
                  BackgroundSource="HostBackdrop"
                  TintColor="{StaticResource MacShellDockAcrylicTintColor}"
                  TintOpacity="0.6"
                  FallbackColor="{StaticResource MacShellDockBackgroundColor}" />

    <AcrylicBrush x:Key="MacShellTopBarAcrylicBrush"
                  BackgroundSource="HostBackdrop"
                  TintColor="{StaticResource MacShellTopBarAcrylicTintColor}"
                  TintOpacity="0.6"
                  FallbackColor="{StaticResource MacShellTopBarBackgroundColor}" />

    <AcrylicBrush x:Key="MacShellLauncherAcrylicBrush"
                  BackgroundSource="HostBackdrop"
                  TintColor="{StaticResource MacShellLauncherPanelBackgroundColor}"
                  TintOpacity="0.8"
                  FallbackColor="{StaticResource MacShellLauncherPanelBackgroundColor}" />

    <!-- ============================================================
         CORNER RADII (same as dark)
         ============================================================ -->
    <x:Double x:Key="MacShellCornerRadiusSmall">4</x:Double>
    <x:Double x:Key="MacShellCornerRadiusMedium">8</x:Double>
    <x:Double x:Key="MacShellCornerRadiusLarge">12</x:Double>
    <x:Double x:Key="MacShellCornerRadiusXLarge">16</x:Double>
    <x:Double x:Key="MacShellCornerRadiusRound">999</x:Double>

    <!-- ============================================================
         SPACING (same as dark)
         ============================================================ -->
    <x:Double x:Key="MacShellSpacingXS">4</x:Double>
    <x:Double x:Key="MacShellSpacingS">8</x:Double>
    <x:Double x:Key="MacShellSpacingM">16</x:Double>
    <x:Double x:Key="MacShellSpacingL">24</x:Double>
    <x:Double x:Key="MacShellSpacingXL">32</x:Double>
    <x:Double x:Key="MacShellSpacingXXL">48</x:Double>

    <!-- ============================================================
         TYPOGRAPHY (same as dark)
         ============================================================ -->
    <FontFamily x:Key="MacShellFontFamily">Segoe UI Variable</FontFamily>

    <x:Double x:Key="MacShellFontSizeXS">11</x:Double>
    <x:Double x:Key="MacShellFontSizeS">12</x:Double>
    <x:Double x:Key="MacShellFontSizeM">13</x:Double>
    <x:Double x:Key="MacShellFontSizeL">14</x:Double>
    <x:Double x:Key="MacShellFontSizeXL">17</x:Double>
    <x:Double x:Key="MacShellFontSizeXXL">28</x:Double>

    <FontWeight x:Key="MacShellFontWeightLight">300</FontWeight>
    <FontWeight x:Key="MacShellFontWeightRegular">400</FontWeight>
    <FontWeight x:Key="MacShellFontWeightMedium">500</FontWeight>
    <FontWeight x:Key="MacShellFontWeightSemibold">600</FontWeight>
    <FontWeight x:Key="MacShellFontWeightBold">700</FontWeight>

    <Style x:Key="MacShellTextStyleCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightRegular}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="MacShellTextStyleBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeS}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightRegular}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="MacShellTextStyleBodySecondary" TargetType="TextBlock" BasedOn="{StaticResource MacShellTextStyleBody}">
        <Setter Property="Foreground" Value="{StaticResource MacShellTextSecondaryBrush}" />
    </Style>

    <Style x:Key="MacShellTextStyleTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeL}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightSemibold}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="MacShellTextStyleTitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeXL}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightSemibold}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="MacShellTextStyleDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MacShellFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MacShellFontSizeXXL}" />
        <Setter Property="FontWeight" Value="{StaticResource MacShellFontWeightLight}" />
        <Setter Property="Foreground" Value="{StaticResource MacShellTextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <!-- ============================================================
         SHADOWS
         ============================================================ -->
    <DropShadow x:Key="MacShellShadowSmall"
                Color="{StaticResource MacShellShadowColor}"
                Opacity="0.1"
                BlurRadius="8"
                Offset="0,2" />

    <DropShadow x:Key="MacShellShadowMedium"
                Color="{StaticResource MacShellShadowColor}"
                Opacity="0.15"
                BlurRadius="20"
                Offset="0,4" />

    <DropShadow x:Key="MacShellShadowLarge"
                Color="{StaticResource MacShellShadowStrongColor}"
                Opacity="0.25"
                BlurRadius="40"
                Offset="0,8" />

    <!-- ============================================================
         ANIMATION DURATIONS
         ============================================================ -->
    <x:Double x:Key="MacShellAnimationFast">150</x:Double>
    <x:Double x:Key="MacShellAnimationNormal">250</x:Double>
    <x:Double x:Key="MacShellAnimationSlow">350</x:Double>

    <EasingFunctionBase x:Key="MacShellEaseOut">ExponentialEase EasingMode="EaseOut" Exponent="3" /></EasingFunctionBase>
    <EasingFunctionBase x:Key="MacShellEaseInOut">CubicEase EasingMode="EaseInOut" /></EasingFunctionBase>
    <EasingFunctionBase x:Key="MacShellSpring">SpringEase Springiness="0.4" /></EasingFunctionBase>

</ResourceDictionary>