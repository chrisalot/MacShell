<Page
    x:Class="MacShell.UI.Views.AboutSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacShell.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="560" HorizontalAlignment="Center">

            <!-- App Icon and Name -->
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Border Width="120" Height="120"
                        CornerRadius="24"
                        Background="{ThemeResource MacShellAccentBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7EE;"
                              FontSize="48"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="MacShell" Style="{StaticResource MacShellTextStyleDisplay}" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <TextBlock Text="A Mac-inspired desktop shell for Windows. Built with WinUI 3 for native performance and a premium experience."
                           Style="{StaticResource MacShellTextStyleBody}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>

            <!-- Links -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Links" Style="{StaticResource MacShellTextStyleTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MacShellButtonStyle}"
                                Content="GitHub"
                                Click="OnGitHubClick" />
                        <Button Style="{StaticResource MacShellButtonStyle}"
                                Content="Documentation"
                                Click="OnDocsClick" />
                        <Button Style="{StaticResource MacShellButtonStyle}"
                                Content="Report Issue"
                                Click="OnIssueClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- License -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="License" Style="{StaticResource MacShellTextStyleTitle}" />
                    <TextBlock Text="MIT License - Free for personal and commercial use."
                               Style="{StaticResource MacShellTextStyleBody}"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource MacShellButtonStyle}"
                            Content="View License"
                            HorizontalAlignment="Left"
                            Click="OnLicenseClick" />
                </StackPanel>
            </Border>

            <!-- Acknowledgments -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Acknowledgments" Style="{StaticResource MacShellTextStyleTitle}" />
                    <TextBlock Text="Built with WinUI 3, Windows App SDK, and Community Toolkit."
                               Style="{StaticResource MacShellTextStyleBody}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Icons from Segoe Fluent Icons."
                               Style="{StaticResource MacShellTextStyleBody}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- System Info -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="System Information" Style="{StaticResource MacShellTextStyleTitle}" />
                    <StackPanel x:Name="SystemInfoPanel" Spacing="4" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>