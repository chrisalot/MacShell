<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacShell.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="560">

            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Dock" Style="{StaticResource MacShellTextStyleDisplay}" />
                <TextBlock Text="Customize dock appearance and behavior" Style="{StaticResource MacShellTextStyleBodySecondary}" />
            </StackPanel>

            <!-- Position -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Position" Style="{StaticResource MacShellTextStyleTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="PosBottom" Content="Bottom" GroupName="DockPosition" IsChecked="True" Style="{StaticResource MacShellRadioButtonStyle}" />
                        <RadioButton x:Name="PosLeft" Content="Left" GroupName="DockPosition" Style="{StaticResource MacShellRadioButtonStyle}" />
                        <RadioButton x:Name="PosRight" Content="Right" GroupName="DockPosition" Style="{StaticResource MacShellRadioButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Size -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Icon Size" Style="{StaticResource MacShellTextStyleTitle}" />
                            <TextBlock x:Name="IconSizeText" Text="48" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <Slider x:Name="IconSizeSlider" Style="{StaticResource MacShellSliderStyle}"
                                Minimum="32" Maximum="64" StepFrequency="4"
                                Value="48"
                                Width="200" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Magnification -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Magnification" Style="{StaticResource MacShellTextStyleTitle}" />
                            <TextBlock Text="Enlarge icons on hover" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MagnificationToggle" Style="{StaticResource MacShellToggleSwitchStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="MagnificationPanel" Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Magnification Factor" Style="{StaticResource MacShellTextStyleBody}" />
                            <TextBlock x:Name="MagnificationFactorText" Text="1.4" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <Slider x:Name="MagnificationFactorSlider" Style="{StaticResource MacShellSliderStyle}"
                                Minimum="1.1" Maximum="2.0" StepFrequency="0.1"
                                Value="1.4"
                                Width="200" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Animation -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Animations" Style="{StaticResource MacShellTextStyleTitle}" />
                            <TextBlock Text="Smooth transitions and effects" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AnimationsToggle" Style="{StaticResource MacShellToggleSwitchStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Running Indicators -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Running Indicators" Style="{StaticResource MacShellTextStyleTitle}" />
                            <TextBlock Text="Show dots under running applications" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RunningIndicatorsToggle" Style="{StaticResource MacShellToggleSwitchStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Auto-hide -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Auto-hide Dock" Style="{StaticResource MacShellTextStyleTitle}" />
                            <TextBlock Text="Automatically hide dock when not in use" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoHideToggle" Style="{StaticResource MacShellToggleSwitchStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="AutoHidePanel" Orientation="Horizontal" HorizontalAlignment="SpaceBetween" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Show Delay" Style="{StaticResource MacShellTextStyleBody}" />
                            <TextBlock x:Name="AutoHideDelayText" Text="200 ms" Style="{StaticResource MacShellTextStyleBodySecondary}" />
                        </StackPanel>
                        <Slider x:Name="AutoHideDelaySlider" Style="{StaticResource MacShellSliderStyle}"
                                Minimum="0" Maximum="1000" StepFrequency="50"
                                Value="200"
                                Width="200" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pinned Apps Management -->
            <Border Style="{StaticResource MacShellCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Pinned Applications" Style="{StaticResource MacShellTextStyleTitle}" />
                    <Button x:Name="ManagePinnedAppsButton"
                            Style="{StaticResource MacShellAccentButtonStyle}"
                            Content="Manage Pinned Apps" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>