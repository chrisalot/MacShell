<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Padding="12,8">

    <StackPanel x:Name="RootPanel" Orientation="Horizontal" Spacing="8">
        <FontIcon x:Name="WeatherIcon"
                  FontSize="18"
                  Foreground="{ThemeResource MacShellAccentBrush}"
                  VerticalAlignment="Center" />

        <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock x:Name="TempText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource MacShellTextPrimaryBrush}" />
            <TextBlock x:Name="ConditionText"
                       FontSize="9"
                       Foreground="{ThemeResource MacShellTextSecondaryBrush}"
                       Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>